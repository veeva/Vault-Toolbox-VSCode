{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "MDL",
	"scopeName": "source.mdl",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#commands" },
		{ "include": "#embedded-xml" },
		{ "include": "#strings" },
		{ "include": "#record-names" },
		{ "include": "#booleans" },
		{ "include": "#component-types" },
		{ "include": "#attributes" },
		{ "include": "#numbers" },
		{ "include": "#expressions" },
		{ "include": "#punctuation" }
	],
	"repository": {
		"comments": {
			"match": "(#|!).*$",
			"name": "comment.line.number-sign.mdl"
		},
		"commands": {
			"match": "\\b(CREATE|RECREATE|ALTER|DROP|RENAME|ADD|MODIFY|IF|NOT|EXISTS|TO|AFTER|FIRST|LAST)\\b",
			"name": "keyword.control.mdl"
		},
		"embedded-xml": {
			"begin": "\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": { "name": "punctuation.section.embedded.begin.mdl" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.section.embedded.end.mdl" }
			},
			"name": "meta.embedded.block.xml",
			"patterns": [{ "include": "text.xml" }]
		},
		"strings": {
			"begin": "'",
			"end": "'",
			"name": "string.quoted.single.mdl",
			"patterns": [
				{
					"match": "\\\\.",
					"name": "constant.character.escape.mdl"
				}
			]
		},
		"record-names": {
			"match": "\\b[a-z][a-zA-Z0-9_.]*__[a-zA-Z0-9]+\\b",
			"name": "variable.other.mdl"
		},
		"booleans": {
			"match": "\\b(true|false)\\b",
			"name": "constant.language.boolean.mdl"
		},
		"component-types": {
			"match": "\\b[A-Z][a-zA-Z0-9]*\\b",
			"name": "entity.name.type.mdl"
		},
		"attributes": {
			"match": "\\b[a-z][a-zA-Z0-9_]*\\b(?=\\s*\\()",
			"name": "entity.other.attribute-name.mdl"
		},
		"numbers": {
			"match": "\\b\\d+(\\.\\d+)?\\b",
			"name": "constant.numeric.mdl"
		},
		"expressions": {
			"begin": "\\[",
			"end": "\\]",
			"beginCaptures": {
				"0": { "name": "punctuation.section.brackets.begin.mdl" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.section.brackets.end.mdl" }
			},
			"name": "meta.expression.mdl",
			"patterns": [
				{
					"match": "[^\\]]+",
					"name": "string.unquoted.expression.mdl"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"match": "\\(",
					"name": "punctuation.section.parens.begin.mdl"
				},
				{
					"match": "\\)",
					"name": "punctuation.section.parens.end.mdl"
				},
				{
					"match": ",",
					"name": "punctuation.separator.mdl"
				},
				{
					"match": ";",
					"name": "punctuation.terminator.statement.mdl"
				}
			]
		}
	}
}
